<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>NetAdapter.Linux</id>
    <version>0.1.0</version>
    <authors>peppekerstens</authors>
    <description>PowerShell NetAdapter module for Linux — mirrors the Windows NetAdapter module surface using ip link (iproute2).</description>
    <tags>PowerShell Linux pwsh Module NetAdapter</tags>
    <projectUrl>https://github.com/peppekerstens/NetAdapter.Linux</projectUrl>
    <license type="expression">GPL-3.0-only</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
  </metadata>
  <files>
    <file src="NetAdapter.Linux\**\*" target="NetAdapter.Linux" />
    <file src="PSScriptAnalyzerSettings.psd1" target="NetAdapter.Linux" />
  </files>
</package>


